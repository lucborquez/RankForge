{
  "info": {
    "name": "RankForge EP3 - aceptación manual pendiente",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Solicitudes preparadas, NO ejecutadas. Leer README. No ejecutar todo con Runner: incluye finalización de torneo y asignación de premios. Tokens e IDs se completan localmente con cuentas y datos de prueba."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "tokenJugador",
      "value": ""
    },
    {
      "key": "tokenOrganizador",
      "value": ""
    },
    {
      "key": "tokenAdmin",
      "value": ""
    },
    {
      "key": "torneoId",
      "value": ""
    },
    {
      "key": "resultadoId",
      "value": ""
    },
    {
      "key": "ganadorId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 Visitante: catálogo de juegos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/juegos",
        "description": "",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP esperado 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "02 Jugador: consultar perfil propio",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/usuarios/me",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenJugador}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP esperado 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 Sin sesión: perfil protegido",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/usuarios/me",
        "description": "",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP esperado 401\", function () { pm.response.to.have.status(401); });"
            ]
          }
        }
      ]
    },
    {
      "name": "04 Jugador: listado de inscripciones prohibido",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/inscripciones",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenJugador}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP esperado 403\", function () { pm.response.to.have.status(403); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 Organizador: listar inscripciones",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/inscripciones",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenOrganizador}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP esperado 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 Visitante: partidas del torneo",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/partidas/torneo/{{torneoId}}",
        "description": "",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP esperado 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07 Jugador: validar resultado prohibido",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": "{{baseUrl}}/api/resultados/{{resultadoId}}/validar",
        "description": "",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenJugador}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP esperado 403\", function () { pm.response.to.have.status(403); });"
            ]
          }
        }
      ]
    },
    {
      "name": "08 Organizador: validar resultado pendiente",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": "{{baseUrl}}/api/resultados/{{resultadoId}}/validar",
        "description": "MUTA DATOS. Requiere resultado coherente de torneo operativo y ranking disponible.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenOrganizador}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP esperado 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "09 Organizador: repetir validación",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": "{{baseUrl}}/api/resultados/{{resultadoId}}/validar",
        "description": "Comprobar además que no se duplican puntos ni registros.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenOrganizador}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP esperado 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "10 Organizador: reconstruir ranking",
      "request": {
        "method": "POST",
        "header": [],
        "url": "{{baseUrl}}/api/rankings/torneo/{{torneoId}}/recalcular",
        "description": "MUTA DATOS. Reconstruye la clasificación desde resultados validados.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenOrganizador}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP esperado 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "11 Visitante: consultar ranking",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/rankings/torneo/{{torneoId}}",
        "description": "",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP esperado 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "12 Administrador: finalizar torneo",
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/torneos/{{torneoId}}/estado",
        "description": "MUTA DATOS. Ejecutar manualmente sólo tras resolver partidas/resultados del torneo de pruebas y comprobar clasificación.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenAdmin}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"estado\":\"FINALIZADO\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP esperado 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "13 Organizador: anular tras finalización prohibido",
      "request": {
        "method": "PATCH",
        "header": [],
        "url": "{{baseUrl}}/api/resultados/{{resultadoId}}/anular?justificacion=Prueba%20de%20cierre",
        "description": "Requiere resultado VALIDADO y torneo FINALIZADO; no usar uno ya ANULADO.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenOrganizador}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP esperado 409\", function () { pm.response.to.have.status(409); });"
            ]
          }
        }
      ]
    },
    {
      "name": "14 Administrador: asignar premio",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/api/torneos/{{torneoId}}/premios",
        "description": "MUTA DATOS. ganadorId debe coincidir con la primera posición; no debe existir premio para esa posición.",
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{tokenAdmin}}",
              "type": "string"
            }
          ]
        },
        "body": {
          "mode": "raw",
          "raw": "{\"posicion\":1,\"participanteId\":{{ganadorId}},\"descripcion\":\"Primer lugar - torneo de pruebas\"}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP esperado 201\", function () { pm.response.to.have.status(201); });"
            ]
          }
        }
      ]
    },
    {
      "name": "15 Visitante: consultar premios",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/torneos/{{torneoId}}/premios",
        "description": "",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP esperado 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    },
    {
      "name": "16 Visitante: consultar avisos",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/torneos/{{torneoId}}/notificaciones",
        "description": "",
        "auth": {
          "type": "noauth"
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"HTTP esperado 200\", function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ]
    }
  ]
}
